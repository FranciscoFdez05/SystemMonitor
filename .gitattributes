# Auto detect text files and perform LF normalization
* text=auto

# Los scripts de despliegue van SIEMPRE con LF. Un checkout en Windows los
# dejaria con CRLF, y en el servidor fallarian nada mas ejecutarlos con un
# error desconcertante: /usr/bin/env: 'sh<CR>': No such file or directory
*.sh text eol=lf
