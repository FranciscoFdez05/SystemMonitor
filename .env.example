# ---- Autenticacion -------------------------------------------------------
SM_USERNAME=admin
# Contrasena en claro: se hashea con Argon2 al arrancar y NO se guarda.
# Para produccion usa SM_PASSWORD_HASH (ver: python -m app.tools.hashpw)
SM_PASSWORD=cambiame
# SM_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
# Clave de firma JWT. Si se deja vacia se genera una y se persiste en data/.
SM_SECRET_KEY=
SM_SESSION_HOURS=12
# Ponlo a true en cuanto pongas TLS delante (Caddy, nginx): impide que el
# navegador mande la cookie de sesion por HTTP en claro.
SM_COOKIE_SECURE=false
# Nombres de host extra aceptados en la cabecera Host. Las IP, localhost y los
# nombres .local/.lan/.home/.internal se aceptan siempre; el resto se rechaza
# para cortar los ataques de DNS rebinding. Usa "*" para desactivar la
# comprobacion (no recomendado).
SM_ALLOWED_HOSTS=

# ---- Servidor ------------------------------------------------------------
SM_HOST=0.0.0.0
SM_PORT=8080
SM_LOG_LEVEL=INFO

# ---- Cadencias de muestreo (segundos) ------------------------------------
SM_FAST_INTERVAL=2.0
SM_SLOW_INTERVAL=6.0
SM_PERSIST_INTERVAL=60.0

# ---- Historico -----------------------------------------------------------
SM_DB_PATH=data/history.db
SM_RETENTION_DAYS=7

# ---- Acceso al host (relevante dentro de Docker) -------------------------
# Punto de montaje del sistema de ficheros raiz del host.
SM_HOST_ROOT=/
# Ruta al /sys del host (temperatura y throttling de la Pi).
SM_SYS_PATH=/sys
# Montajes extra a vigilar si el bind no es recursivo, separados por coma.
SM_EXTRA_MOUNTS=
# Solo si NO se usa "pid: host": ruta al /proc del host.
SM_PROCFS_PATH=

# ---- Seguridad de operaciones --------------------------------------------
SM_ALLOW_KILL=true
# Permitir matar procesos que no pertenecen al usuario de la app (requiere root).
SM_ALLOW_KILL_FOREIGN=false
SM_PROTECTED_PROCESSES=systemd,init,sshd,dockerd,containerd

# ---- Alertas -------------------------------------------------------------
SM_ALERT_WEBHOOK_URL=
SM_TELEGRAM_BOT_TOKEN=
SM_TELEGRAM_CHAT_ID=
SM_DISCORD_WEBHOOK_URL=
